{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ia-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "IA-local (agente)",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "{env:AGENT_API_KEY}"
      },
      "models": {
        "ia-agent": {
          "name": "ia-agent"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (directo)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {}
    }
  }
}

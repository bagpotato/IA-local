# --- Servidor ---
# install.sh genera una clave aleatoria si este fichero no existe. Sin clave el servidor no arranca.
AGENT_API_KEY=
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
# native | crewai
AGENT_ENGINE=native
AGENT_DEBUG=false

# --- Ollama y modelos ---
OLLAMA_HOST=http://127.0.0.1:11434
# Los elige el usuario en scripts/install.sh (nombres de `ollama list`)
LLM_MODEL=
VISION_MODEL=
EMBED_MODEL=
# Modelo del router de CrewAI (vacío = LLM_MODEL)
ROUTER_MODEL=
# Sube a 16384 para investigar mejor (usa más RAM/VRAM)
NUM_CTX=8192
MAX_ITERATIONS=6

# --- Modo 1 (mínimo): ENABLE_CODE=false, ENABLE_MEMORY=false, ENABLE_SCREEN=false
# --- Modo 2 (completo y seguro): los tres a true
ENABLE_WEB=true
ENABLE_FILES=true
ENABLE_CODE=false
ENABLE_MEMORY=false
ENABLE_SCREEN=false
# Subagentes: la herramienta delegate reparte tareas independientes en paralelo (solo con herramientas no peligrosas)
ENABLE_SUBAGENTS=true
MAX_SUBAGENTS=4
SUBAGENT_ITERATIONS=4
# Subagentes simultáneos; súbelo si tu Ollama tiene OLLAMA_NUM_PARALLEL > 1 y memoria de sobra
SUBAGENT_CONCURRENCY=2
# Tras tocar contenido web/pantalla se bloquean escribir ficheros, ejecutar y guardar memoria hasta el siguiente turno
TAINT_LOCK=true

# --- Ficheros y límites ---
WORKSPACE_DIR=~/ia-workspace
MAX_FILE_BYTES=1000000
MAX_IMAGE_BYTES=8000000
MAX_AUDIO_BYTES=25000000
AGENT_DB_PATH=data/agent.db

# --- Código (sandbox Docker) ---
SANDBOX_IMAGE=python:3.12-slim
CODE_TIMEOUT=20

# --- Memoria (Qdrant embebido): ruta de carpeta, ":memory:" para pruebas o http://host:6333 para un servidor ---
QDRANT_URL=data/qdrant

# --- Visión ---
WEBCAM_INDEX=0

# --- Audio ---
WHISPER_MODEL=base
# auto | cpu | cuda
WHISPER_DEVICE=auto
PIPER_VOICE=es_ES-davefx-medium
PIPER_DATA_DIR=voices
# gTTS envía el texto a un servicio externo: déjalo en false salvo que lo quieras
TTS_ALLOW_ONLINE=false
TTS_LANG=es

# --- Server ---
# install.sh generates a random key if this file does not exist. Without a key the server does not start.
AGENT_API_KEY=
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
# native | crewai
AGENT_ENGINE=native
AGENT_DEBUG=false

# --- Ollama and models ---
OLLAMA_HOST=http://127.0.0.1:11434
# Chosen by the user in scripts/install.sh (names from `ollama list`)
LLM_MODEL=
VISION_MODEL=
EMBED_MODEL=
# CrewAI router model (empty = LLM_MODEL)
ROUTER_MODEL=
# Raise to 16384 for better research (uses more RAM/VRAM)
NUM_CTX=8192
MAX_ITERATIONS=6

# --- Mode 1 (minimal): ENABLE_CODE=false, ENABLE_MEMORY=false, ENABLE_SCREEN=false
# --- Mode 2 (full and safe): all three true
ENABLE_WEB=true
ENABLE_FILES=true
ENABLE_CODE=false
ENABLE_MEMORY=false
ENABLE_SCREEN=false
# Subagents: the delegate tool splits independent tasks in parallel (non-dangerous tools only)
ENABLE_SUBAGENTS=true
MAX_SUBAGENTS=4
SUBAGENT_ITERATIONS=4
# Simultaneous subagents; raise it if your Ollama has OLLAMA_NUM_PARALLEL > 1 and spare memory
SUBAGENT_CONCURRENCY=2
# After touching web/screen content, writing files, running code and saving memory are blocked until the next turn
TAINT_LOCK=true

# --- Files and limits ---
WORKSPACE_DIR=~/ia-workspace
MAX_FILE_BYTES=1000000
MAX_IMAGE_BYTES=8000000
MAX_AUDIO_BYTES=25000000
AGENT_DB_PATH=data/agent.db

# --- Code (Docker sandbox) ---
SANDBOX_IMAGE=python:3.12-slim
CODE_TIMEOUT=20

# --- Memory (embedded Qdrant): folder path, ":memory:" for tests or http://host:6333 for a server ---
QDRANT_URL=data/qdrant

# --- Vision ---
WEBCAM_INDEX=0

# --- Audio ---
WHISPER_MODEL=base
# auto | cpu | cuda
WHISPER_DEVICE=auto
PIPER_VOICE=es_ES-davefx-medium
PIPER_DATA_DIR=voices
# gTTS sends the text to an external service: leave it false unless you want it
TTS_ALLOW_ONLINE=false
TTS_LANG=es
